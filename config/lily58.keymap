#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
&soft_off {
  hold-time-ms = <2000>; //Only turn off it the key is held for 2 second
    
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// --------------------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |    5    |                       |  6      |  7    |  8    |  9   |   0   |     -     |
// |  TAB  |  Q  |  W  |  E   |  R   |    T    |                       |  Y      |  U    |  I    |  O   |   P   |     \     |
// |  CTRL |  A  |  S  |  D   |  F   |    G    |                       |  H      |  J    |  K    |  L   |   ;   |     '     |
// | SHIFT |  Z  |  X  |  C   |  V   |    B    | FUNCTION |  | SPECIAL |  N      |  M    |  ,    |  .   |   /   |   SHIFT   |
//                     | GUI  | ALT  |  NUMBER |  ENTER   |  | SPACE   | SYMBOLS | BSPC  | GUI   |

            bindings = <
&kp ESC             &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                       &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp MINUS
&kp TAB             &kp Q  &kp W  &kp E    &kp R    &kp T                        &kp Y  &kp U    &kp I     &kp O   &kp P    &kp BSLH
&mt LCTRL LC(SPACE) &kp A  &kp S  &kp D    &kp F    &kp G                        &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT           &kp Z  &kp X  &kp C    &kp V    &kp B  &trans    &to 0       &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                                  &kp LGUI &kp LALT &sl 4  &mt 1 RET &mt 3 SPACE &sl 2  &kp BSPC &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        number_layer {
// ------------------------------------------------------------------------------------
// |     |  1  |  2  |  3  |  4  |  5  |              |  6  | 7 |  8  |  9  | 0 |     |
// |     |  +  |  -  |  *  |  /  |  =  |              |  .  | , |     |     |   |     |
// |     |     |     |     |     |     |              | <-  | v |  ^  | ->  |   |     |
// |     |     |     |     |     |     |     |  |     |     |   |     |     |   |     |
//                   |     |     |     |     |  |     |     |   |     |
            bindings = <
&trans &kp KP_N1   &kp KP_N2    &kp KP_N3       &kp KP_N4     &kp KP_N5                  &kp KP_N6  &kp KP_N7    &kp KP_N8 &kp KP_N9 &kp KP_N0 &trans
&trans &kp KP_PLUS &kp KP_MINUS &kp KP_MULTIPLY &kp KP_DIVIDE &kp KP_EQUAL               &kp KP_DOT &kp KP_COMMA &trans    &trans    &trans    &trans
&trans &trans      &trans       &trans          &trans        &trans                     &kp LEFT   &kp DOWN     &kp UP    &kp RIGHT &trans    &trans
&trans &trans      &trans       &trans          &trans        &trans       &trans &trans &trans     &trans       &trans    &trans    &trans    &trans
                                &trans          &trans        &trans       &trans &trans &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbols_layer {
// ----------------------------------------------------------------------------------------------------------
// |  `    |   !    |   @    |  #   |  $   |  %   |              |   ^   |  &  |  *   |  (    |  )   |  -   | 
// |   ~   |   [    |   ]    |  {   |  }   |      |              |       |     |      |       |      |  _   |
// |  CAPS |        |        |      |      |      |              |       |     |      |       |      |  |   |
// |       |        |        |      |      |      |     |  |     |       |     |      |       |      |      |
//                           |      |      |      |     |  |     |       |     |      |
            bindings = <
&kp GRAVE &kp EXCL &kp AT   &kp HASH &kp DOLLAR &kp PRCNT               &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR &kp MINUS
&kp TILDE &kp LBKT &kp RBKT &kp LBRC &kp RBRC   &trans                  &trans    &trans   &trans   &trans   &trans   &kp UNDER
&kp CAPS  &trans   &trans   &trans   &trans     &trans                  &trans    &trans   &trans   &trans   &trans   &kp PIPE 
&trans    &trans   &trans   &trans   &trans     &trans    &trans &trans &trans    &trans   &trans   &trans   &trans   &trans 
                            &trans   &trans     &trans    &trans &trans &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
// ----------------------------------------------------------------------------------------------------------------------------
// | OUT_TOG | BRI_DN | BRI_UP |       |       |       |                   |  PRV  |  P/S  |  NXT  |  MUTE  |  VDOWN  |  VUP  |
// |  BTCLR  |   BT5  |   BT4  |  BT3  |  BT2  |  BT1  |                   |       |       |       |        |         |       | 
// |         |        |        |       |       |       |     |  |          |       |       |       |        |         |       |
// |         |        |        |       |       |       | L0  |  | soft_off |       |       |       |        |         |       |
//                    |        |       |       |       |     |  |          |       |       |
            bindings = <
&out OUT_TOG &kp C_BRI_DN &kp C_BRI_UP &trans       &trans       &trans                     &kp C_PREV &kp C_PP &kp C_NEXT &kp K_MUTE &kp C_VOL_DN &kp C_VOL_UP
&bt BT_CLR   &bt BT_SEL 4 &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0               &trans     &trans   &trans     &trans     &trans       &trans
&trans       &trans       &trans       &trans       &trans       &trans                     &trans     &trans   &trans     &trans     &trans       &trans
&trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans     &trans   &trans     &trans     &trans       &trans
                                       &trans       &trans       &trans       &trans &trans &trans     &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Special_layer {
// ----------------------------------------------------------------------------------------------
// |     |     |     |     |     |     |                    |     |     |     |     |     |     |
// |     |     |     |     |     |     |                    |     |     |     |     |     |     | 
// |     |     |     |     |     |     |                    |     |     |     |     |     |     |
// |     |     |     |     |     |     |     |        |     |     |     |     |     |     |     | 
//                   |     |     |     |     |        |     |     |     |     |
            bindings = <
&trans &kp LA(N1) &kp LA(N2)  &kp LA(N3) &kp LA(N4) &kp LA(N5)                &kp LA(N6) &kp LA(N7) &kp LA(N8) &kp LA(N9) &trans &trans
&trans &trans     &trans      &trans     &trans     &trans                    &trans     &trans     &trans     &trans     &trans &trans
&trans &trans     &trans      &trans     &trans     &trans                    &trans     &trans     &trans     &trans     &trans &trans
&trans &trans     &trans      &trans     &trans     &trans     &trans  &trans &trans     &trans     &trans     &trans     &trans &trans
                              &trans     &trans     &trans     &trans  &trans &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
