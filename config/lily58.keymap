#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
&soft_off {
  hold-time-ms = <2000>; //Only turn off it the key is held for 2 second
  /delete-property/ split-peripheral-off-on-press; // 叫右手不要偷跑立即關機，左右手一起等滿 2 秒
    
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_panic {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ---------------------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |    5    |                          |  6    |  7    |  8    |  9   |   0   |     -     |
// |  TAB  |  Q  |  W  |  E   |  R   |    T    |                          |  Y    |  U    |  I    |  O   |   P   |     \     |
// |  CTRL |  A  |  S  |  D   |  F   |    G    |                          |  H    |  J    |  K    |  L   |   ;   |     '     |
// | SHIFT |  Z  |  X  |  C   |  V   |    B    |  CHEWING  |  |           |  N    |  M    |  ,    |  .   |   /   |   SHIFT   |
//                     | GUI  | ALT  |  NUMBER |  ENTER/1  |  |  SPACE/2  | SHORT | BSPC  | GUI   |

            bindings = <
&kp ESC             &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                       &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp MINUS
&kp TAB             &kp Q  &kp W  &kp E    &kp R    &kp T                        &kp Y  &kp U    &kp I     &kp O   &kp P    &kp BSLH
&mt LCTRL LC(SPACE) &kp A  &kp S  &kp D    &kp F    &kp G                        &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT           &kp Z  &kp X  &kp C    &kp V    &kp B  &tog 3    &trans      &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                                  &sk LGUI &sk LALT &sl 1  &lt 1 RET &lt 2 SPACE &sl 2  &kp BSPC &sk RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        short_layer {
// -----------------------------------------------------------------------------------------------------
// |  `   |   !  |   @  |   #   |   $  |   %  |              |   ^  |   &  |   *  |   -  |   +  |  =   | 
// |  ~   |      |      |   {   |   [  |   (  |              |   )  |   ]  |   }  |      |      |  _   |
// | CAPS |      |      |       |      |      |              |   <  |   v  |   ^  |   >  |      |  |   |
// |      |      |      |       |      |      |     |  |     |      |      |      |      |      |      |
//                      |       |      |      |     |  |     |      |      |      |
            bindings = <
&kp GRAVE  &kp EXCL &kp AT &kp HASH &kp DOLLAR &kp PRCNT               &kp CARET &kp AMPS &kp STAR &kp MINUS &kp PLUS &kp EQUAL
&kp TILDE  &trans   &trans &kp LBRC &kp LBKT   &kp LPAR                &kp RPAR  &kp RBKT &kp RBRC &trans    &trans   &kp UNDER
&kp CAPS   &trans   &trans &trans   &kp LG(C)  &kp LG(V)               &kp LEFT  &kp DOWN &kp UP   &kp RIGHT &trans   &kp PIPE
&trans     &trans   &trans &trans   &trans     &trans    &trans &trans &trans    &trans   &trans   &trans    &trans   &trans
                           &trans   &trans     &trans    &trans &trans &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
// ---------------------------------------------------------------------------------------------------------------------------------
// |         | BRI_DN | BRI_UP |       |       |       |                |   PRV   |   P/S    |   NXT    |  MUTE  |  VDOWN  |  VUP  |
// |  BTCLR  |   BT5  |   BT4  |  BT3  |  BT2  |  BT1  |                | NVIM PD | NVIM PU  |          |        |         |       | 
// |         | WIND 1 | WIND 2 | WIN 3 | WIN 4 | WIN 5 |                | FF PRV  |FF TAB PRV|FF TAB NXT| FF NXT |         |       |
// |         | WIND 6 | WIND 7 | WIN 8 | WIN 9 |       |      |  |      |         |          |          |        |         |       |
//                    |        |       |       |       |      |  |      |         |          |
            bindings = <
&trans     &kp C_BRI_DN &kp C_BRI_UP &trans       &trans       &trans                                   &kp C_PREV   &kp C_PP          &kp C_NEXT       &kp K_MUTE    &kp C_VOL_DN &kp C_VOL_UP
&bt BT_CLR &bt BT_SEL 4 &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0                             &kp LC(D)    &kp LC(U)         &trans           &trans        &trans       &trans
&trans     &kp LA(N1)   &kp LA(N2)   &kp LA(N3)   &kp LA(N4)   &kp LA(N5)                               &kp LG(LEFT) &kp LG(LA(RIGHT)) &kp LG(LA(LEFT)) &kp LG(RIGHT) &trans       &trans
&trans     &kp LA(N6)   &kp LA(N7)   &kp LA(N8)   &kp LA(N9)   &trans       &ext_power EP_TOG &soft_off &trans       &trans            &trans           &trans        &trans       &trans
                                     &trans       &trans       &trans       &trans            &trans    &trans       &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        chewing_layer {
// ---------------------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |    5    |                          |  6    |  7    |  8    |  9   |   0   |     -     |
// |  TAB  |  Q  |  W  |  E   |  R   |    T    |                          |  Y    |  U    |  I    |  O   |   P   |     \     |
// |  CTRL |  A  |  S  |  D   |  F   |    G    |                          |  H    |  J    |  K    |  L   |   ;   |     '     |
// | SHIFT |  Z  |  X  |  C   |  V   |    B    |           |  |           |  N    |  M    |  ,    |  .   |   /   |   SHIFT   |
//                     | GUI  | ALT  |  NUMBER |  ENTER/1  |  |  SPACE/2  | SHORT | BSPC  | GUI   |

            bindings = <
&trans &trans   &trans   &trans   &trans   &trans                 &trans    &trans     &trans              &trans          &trans            &trans
&trans &mt N1 Q &mt N2 W &mt N3 E &mt N4 R &mt N5 T               &mt N6 Y  &mt N7 U   &mt N8 I            &mt N9 O        &mt N0 P          &trans
&trans &kp A    &kp S    &kp D    &kp F    &kp G                  &kp H     &kp J      &kp K               &kp L           &mt MINUS SEMI    &trans
&trans &kp Z    &kp X    &kp C    &kp V    &kp B    &trans &trans &mt SQT N &mt BSLH M &mt LS(COMMA) COMMA &mt LS(DOT) DOT &mt LS(FSLH) FSLH &trans
                         &trans   &trans   &trans   &trans &trans &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
