#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
&soft_off {
  hold-time-ms = <2000>; //Only turn off it the key is held for 2 second
    
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5     |                  |  6    |  7    |  8    |  9   |   0   |     -     |
// |  TAB  |  Q  |  W  |  E   |  R   |  T     |                  |  Y    |  U    |  I    |  O   |   P   |     \     |
// |  CTRL |  A  |  S  |  D   |  F   |  G     |                  |  H    |  J    |  K    |  L   |   ;   |     '     |
// | SHIFT |  Z  |  X  |  C   |  V   |  B     |  "["  |  |  "]"  |  N    |  M    |  ,    |  .   |   /   |   SHIFT   |
//                     | GUI  | ALT  |  LOWER | ENTER |  | SPACE | RAISE | BSPC  | GUI   |

            bindings = <
&kp ESC             &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                   &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp MINUS
&kp TAB             &kp Q  &kp W  &kp E    &kp R    &kp T                    &kp Y  &kp U    &kp I     &kp O   &kp P    &kp BSLH
&mt LCTRL LC(SPACE) &kp A  &kp S  &kp D    &kp F    &kp G                    &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT           &kp Z  &kp X  &kp C    &kp V    &kp B  &tog 3  &tog 4    &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                                  &kp LGUI &kp LALT &tog 1 &kp RET &kp SPACE &sl 2  &kp BSPC &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
// ----------------------------------------------------------------------------------------
// |     |     |     |     |     |     |              |     |     |     |     |     |     |
// |     |  7  |  8  |  9  |  /  |  *  |              |     |     |     |     |     |     |
// |     |  4  |  5  |  6  |  -  |  +  |              |     |     |     |     |     |     |
// |     |  1  |  2  |  3  |  0  |  .  |     |  |     |     |     |     |     |     |     |
//                   |     |     |     |     |  |     |     |     |     |
            bindings = <
&trans &trans    &trans    &trans    &trans        &trans                        &trans   &trans    &trans  &trans    &trans &trans
&trans &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_DIVIDE &kp KP_MULTIPLY               &kp DEL  &kp PSCRN &trans  &trans    &trans &trans
&trans &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_MINUS  &kp KP_PLUS                   &kp LEFT &kp DOWN  &kp UP  &kp RIGHT &trans &trans
&trans &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_N0     &kp KP_DOT      &trans &trans &trans   &trans    &trans  &trans    &trans &trans
                           &trans    &trans        &trans          &trans &trans &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
// ----------------------------------------------------------------------------------------------------------
// |       |        |        |      |      |      |              |       |     |      |       |      |      |
// |  `    |   !    |   @    |  #   |  $   |  %   |              |   ^   |  &  |  *   |  (    |  )   |  -   | 
// | CAPS  |        |        |      |  {   |  [   |              |   ]   |  }  |      |       |      |  _   |
// |  ~    |        |        |      |      |      |     |  |     |       |     |      |       |      |  |   |
//                           |      |      |      |     |  |     |       |     |      |
            bindings = <
&trans    &trans   &trans &trans   &trans     &trans                  &trans    &trans   &trans   &trans   &trans    &trans 
&kp GRAVE &kp EXCL &kp AT &kp HASH &kp DOLLAR &kp PRCNT               &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR  &kp MINUS
&kp CAPS  &trans   &trans &trans   &kp LBRC   &kp LBKT                &kp RBKT  &kp RBRC &trans   &trans   &trans    &kp UNDER
&kp TILDE &trans   &trans &trans   &trans     &trans    &trans &trans &trans    &trans   &trans   &trans   &trans    &kp PIPE 
                          &trans   &trans     &trans    &trans &trans &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
// -----------------------------------------------------------------------------------------------------------------------------
// | OUT_TOG | BRI_DN | BRI_UP |       |       |       |                    |  PRV  |  P/S  |  NXT  |  MUTE  |  VDOWN  |  VUP  |
// |  BTCLR  |   BT1  |   BT2  |  BT3  |  BT4  |  BT5  |                    |       |       |       |        |         |       | 
// |   F1    |   F2   |   F3   |  F4   |  F5   |  F6   |                    |  F7   |  F8   |  F9   |  F10   |  F11    |  F12  |
// |         |        |        |       |       |       |     |        |     |       |       |       |        |         |       | 
//                    |        |       |       |       |     |        |     |       |       |
            bindings = <
&trans       &trans       &trans       &trans       &trans       &trans                     &trans     &trans   &trans     &trans     &trans       &trans
&out OUT_TOG &kp C_BRI_DN &kp C_BRI_UP &trans       &trans       &trans                     &kp C_PREV &kp C_PP &kp C_NEXT &kp K_MUTE &kp C_VOL_DN &kp C_VOL_UP
&kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6                     &kp F7     &kp F8   &kp F9     &kp F10    &kp F11      &kp F12
&bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &to 0  &trans &trans     &trans   &trans     &trans     &trans       &trans
                                       &trans       &trans       &trans       &trans &trans &trans     &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Special_layer {
// ----------------------------------------------------------------------------------------------
// |     |     |     |     |     |     |                    |     |     |     |     |     |     |
// |     |     |     |     |     |     |                    |     |     |     |     |     |     | 
// |     |     |     |     |     |     |                    |     |     |     |     |     |     |
// |     |     |     |     |     |     |     |        |     |     |     |     |     |     |     | 
//                   |     |     |     |     |        |     |     |     |     |
            bindings = <
&trans &trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans &trans
                     &trans &trans &trans &trans  &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
